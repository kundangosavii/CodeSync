---
import { getCollection } from "astro:content";

const docs = await getCollection("docs");

if (docs.length === 0) {
  throw new Error("No docs found");
}

docs.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

return Astro.redirect(`${import.meta.env.BASE_URL}/docs/getting-started/install`);
---